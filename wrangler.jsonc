{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kafu-people-pages",
  "compatibility_date": "2026-03-09",
  "main": "./worker/index.js",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // AI Training Coaching enrollments, written by worker/stripe-webhook.ts.
  // Apply schema: npx wrangler d1 migrations apply kafu-enrollments --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kafu-enrollments",
      "database_id": "787b029f-ac46-4541-b53f-1c36a492066b",
      "migrations_dir": "migrations"
    }
  ],
  // Non-secret settings. Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
  // RESEND_API_KEY, SLACK_WEBHOOK_URL) are set with `wrangler secret put`.
  "vars": {
    "FROM_EMAIL": "Kafu People <training@kafupeople.com>",
    "ONBOARDING_URL": "https://calendly.com/kafupeople/30min"
  }
}
