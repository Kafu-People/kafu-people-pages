{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kafu-people-pages",
  "compatibility_date": "2026-03-09",
  "main": "./worker/index.js",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
